# Copy to .env and fill in. .env is git-ignored.
# Real environment variables always win over this file.

# ---------- AI analysis (OpenAI-compatible) ----------
# Works with OpenAI, OpenRouter, Groq, Azure, vLLM, Ollama, LM Studio, ...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_ANALYSIS_ENABLED=1
AI_MAX_ROWS=40
AI_TIMEOUT_MS=60000
# Percent change in a column total before it is flagged as an anomaly.
AI_ANOMALY_THRESHOLD=30

# ---------- Config dashboard ----------
DASHBOARD_PASSWORD=
DASHBOARD_PORT=8787
DASHBOARD_PUBLIC_URL=http://localhost:8787

# ---------- OTP relay ----------
OTP_SERVER_PORT=80
OTP_SERVER_URL=http://127.0.0.1
# Set to a remote URL to mirror OTPs down to this host, empty to disable.
OTP_RELAY_URL=

# ---------- Google Drive ----------
DRIVE_ROOT_FOLDER=retail-reports

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=

# ---------- Store credentials (optional; keys.json is the fallback) ----------
FBUSINESSCENTER_EMAIL=
FBUSINESSCENTER_PASSWORD=
RIPLEY_EMAIL=
RIPLEY_PASSWORD=
MERCADOLIBRE_EMAIL=
MERCADOLIBRE_PASSWORD=
WALMART_EMAIL=
WALMART_PASSWORD=
CAPSOLVER_API_KEY=