{
  "workflowDateVariables": {
    "falabellaVentasHistoricas": "thisMonth",
    "falabellaAnalisisInventario": "none",
    "sodimacVentasHistoricas": "customMonthToYesterday",
    "sodimacAnalisisInventario": "none",
    "tottusVentasHistoricas": "thisMonth",
    "tottusVentasInventario": "yesterday"
  },
  "dateModes": {
    "none": {
      "steps": []
    },
    "thisMonth": {
      "open": {
        "selector": "span[role=\"button\"]",
        "text": "Previous Week"
      },
      "dialog": true,
      "steps": [
        { "action": "clickText", "text": "More" },
        { "action": "clickText", "text": "This Month" }
      ]
    },
    "today": {
      "open": { "selector": "span[role=\"button\"][aria-selected=\"true\"]" },
      "dialog": true,
      "steps": [{ "action": "clickText", "text": "Today" }]
    },
    "yesterday": {
      "open": {
        "selector": "span[role=\"button\"][aria-selected=\"true\"]"
      },
      "dialog": true,
      "steps": [
        { "action": "clickText", "text": "More" },
        { "action": "clickText", "text": "Yesterday" }
      ]
    },
    "last7Days": {
      "open": { "selector": "span[role=\"button\"][aria-selected=\"true\"]" },
      "dialog": true,
      "steps": [{ "action": "clickText", "text": "Last 7 Days" }]
