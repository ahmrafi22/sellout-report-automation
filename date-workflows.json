    "customMonthToYesterday": {
      "open": {
        "selector": "span[role=\"button\"][aria-selected=\"true\"]"
      },
      "dialog": true,
      "steps": [
        { "action": "clickText", "text": "Custom" },
        {
          "action": "fill",
          "field": "date-from-text-input",
          "selector": "[data-testid=\"date-from-text-input\"]",
          "value": "firstDayOfCurrentMonth"
        },
        {
          "action": "fill",
          "field": "date-to-text-input",
          "selector": "[data-testid=\"date-to-text-input\"]",
          "value": "yesterday"
        },
        {
          "action": "click",
          "selector": "button[class*=\"RunButton__IconButtonWithBackground\"]"
        }
      ]
    }
  }
